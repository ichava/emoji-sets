{
    "name": "ichava/emoji-sets",
    "description": "Multi-source emoji bundle for Laravel: Twemoji (Twitter/X), OpenMoji color + black. Unicode 17 / Emoji 17 spec. Categorised by CLDR groups. Built on the Ichava ecosystem.",
    "type": "library",
    "keywords": [
        "laravel",
        "blade",
        "emoji",
        "emojis",
        "svg",
        "twemoji",
        "openmoji",
        "unicode",
        "ichava"
    ],
    "homepage": "https://opensource.simtabi.com/products/ichava/emoji-sets",
    "license": "MIT",
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "homepage": "https://simtabi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/support": "^13.0",
        "ichava/core": "^0.2.5",
        "laranail/package-tools": "^0.1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ichava/core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator.git"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.6 || ^5.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\EmojiSets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\EmojiSets\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Ichava\\EmojiSets\\Providers\\IconsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "lint": "@pint",
        "format": "@pint-fix",
        "test": "vendor/bin/pest --parallel",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/ichava/emoji-sets",
        "issues": "https://github.com/ichava/emoji-sets/issues",
        "security": "https://github.com/ichava/emoji-sets/security/policy",
        "docs": "https://opensource.simtabi.com/documentation/ichava/emoji-sets/"
    }
}

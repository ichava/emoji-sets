# A Python virtualenv is used here to build the corpus from three upstreams.
# Kept because one exists in this checkout; the former scripts/.cache and
# scripts/.downloads entries are gone, since scripts/ has never been tracked
# in this repository.
.venv/
__pycache__/
*.py[cod]
